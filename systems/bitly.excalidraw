    {
      "id": "mvfLo7yiXY4DaiaFO-4rj",
      "type": "text",
      "x": 4701.495538040412,
      "y": 4372.913992690327,
      "width": 730.5992431640625,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
