    },
    {
      "id": "Wy-Qaszp-9MG74NsbG4vY",
      "type": "text",
      "x": 3740.3965412798693,
      "y": 2989.167936580146,
      "width": 775.4791870117188,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 908071216,
      "version": 851,
      "versionNonce": 921119615,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779874998703,
      "link": null,
      "locked": false,
      "text": "Return Codes:\n\n→ ✅ If short code is found and hasn't expired (by comparing the current date to the\nexpiration date in the database), the server retrieves the corresponding long URL. 302\n\n→ 🔍❌ Not found URLs, return 404.\n\n→ 💀 Expired URLs, return 410 Gone status.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "bMJwbpHiSCxyII5SFy7pP",
      "originalText": "Return Codes:\n\n→ ✅ If short code is found and hasn't expired (by comparing the current date to the expiration date in the database), the server retrieves the corresponding long URL. 302\n\n→ 🔍❌ Not found URLs, return 404.\n\n→ 💀 Expired URLs, return 410 Gone status.",
      "autoResize": true,
      "lineHeight": 1.25
    },
