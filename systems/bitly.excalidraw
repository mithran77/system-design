    {
      "id": "SdqPQBXxxO8CwKYj6bsdc",
      "type": "text",
      "x": 4728.084211833549,
      "y": 1866.6529741612112,
      "width": 809.9991455078125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
