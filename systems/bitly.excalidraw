    {
      "id": "WMyLBA3kF34CJH1pK1GiU",
      "type": "text",
      "x": 1751.2317284861442,
      "y": 6148.662048236254,
      "width": 796.493408203125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2L",
      "roundness": null,
      "seed": 480116395,
      "version": 2151,
      "versionNonce": 1021176369,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779890362576,
      "link": null,
      "locked": false,
      "text": "🤔 To determine whether we should be concerned about length, we can do a little math.\n\n→ 🔢 If we have 1B URLs, when base62 encoded, this would result in a 6-character\nstring. Here's why:\n        → 💡 1,000,000,000 in base62 is '15ftgG'\n        → 📦 This means that even with a billion URLs, our short codes would still be quite\ncompact.\n        → 📈 At 62^6 (approximately 56 billion URLs), we'd need to move to 7-character\ncodes, giving us capacity for 62^7 (over 3.5 trillion) URLs.\n        → 🚀 This scalability allows us to handle a massive number of URLs while keeping\nthe codes short.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Lm_03pr_eFEx2GGfTsUu3",
      "originalText": "🤔 To determine whether we should be concerned about length, we can do a little math.\n\n→ 🔢 If we have 1B URLs, when base62 encoded, this would result in a 6-character string. Here's why:\n        → 💡 1,000,000,000 in base62 is '15ftgG'\n        → 📦 This means that even with a billion URLs, our short codes would still be quite compact.\n        → 📈 At 62^6 (approximately 56 billion URLs), we'd need to move to 7-character codes, giving us capacity for 62^7 (over 3.5 trillion) URLs.\n        → 🚀 This scalability allows us to handle a massive number of URLs while keeping the codes short.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lgZgjAN7D7_naa0Ua4GVV",
