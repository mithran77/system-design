    {
      "id": "hkCs3Ol4LAZmVjZIAM0N9",
      "type": "text",
      "x": 840.5343477426622,
      "y": 5082.297799455883,
      "width": 806.1992797851562,
      "height": 1250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1L",
