    {
      "id": "vM-Kon9ImapOrBba0mkFc",
      "type": "text",
      "x": 847.9993185002199,
      "y": 4082.3002095743745,
      "width": 809.3792114257812,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Q",
