    {
      "id": "R4nDOFOZykRsfvP00h0HT",
      "type": "rectangle",
      "x": -1110.5196744529867,
      "y": 3888.981127643252,
      "width": 825.5660271246614,
      "height": 3092.987434568986,
      "angle": 0,
      "strokeColor": "#1e1e1e",
