    {
      "id": "nj_8YFiSyT8-vfV7m2rrq",
      "type": "text",
      "x": 395.5693521499634,
      "y": 1089.3349318504333,
      "width": 349.61962890625,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2c",
      "roundness": null,
      "seed": 1704821744,
      "version": 202,
      "versionNonce": 1132492048,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769163601485,
      "link": null,
      "locked": false,
      "text": "API:\n\n\nJWT/session token\n\nPOST /v1/tribes/:tribeId/join\nAuthenticated\n\n\nPOST /v1/events/:eventId/perform\nAuthenticated\n\nGET /v1/leaderboard\n->\n{\n    tier: {\n        tribeInfo,\n        points\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API:\n\n\nJWT/session token\n\nPOST /v1/tribes/:tribeId/join\nAuthenticated\n\n\nPOST /v1/events/:eventId/perform\nAuthenticated\n\nGET /v1/leaderboard\n->\n{\n    tier: {\n        tribeInfo,\n        points\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
