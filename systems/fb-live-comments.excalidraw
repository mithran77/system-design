    },
    {
      "id": "q038NmK-fchldysVTHDaT",
      "type": "text",
      "x": 3788.744515579794,
      "y": 6470.985375916899,
      "width": 809.4591064453125,
      "height": 975,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3G",
