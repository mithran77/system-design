    {
      "id": "IvkitoLCIVE2wzWi55sgR",
      "type": "rectangle",
      "x": 1734.8915329617957,
      "y": 5209.99281048106,
      "width": 825.5660271246614,
      "height": 1025.8177818255722,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
