    {
      "id": "5rkwC-x1bSSOvHKWWSVyz",
      "type": "text",
      "x": 3921.9669796417274,
      "y": 2876.106524967244,
      "width": 550.45947265625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
