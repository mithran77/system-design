      "link": null,
      "locked": false,
      "text": "Access pattern,\n\n→ Real-time new comments on arrival — via SSE (Server-Sent Events) 📡\n→ On page load, fetch comment history via API call in descending order (newest first)\n→ Scrolling through history uses pagination via API to load older comments\nincrementally",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "OsIEHfyUP8dPL2shnlZxu",
      "originalText": "Access pattern,\n\n→ Real-time new comments on arrival — via SSE (Server-Sent Events) 📡\n→ On page load, fetch comment history via API call in descending order (newest first)\n→ Scrolling through history uses pagination via API to load older comments incrementally",
      "autoResize": true,
      "lineHeight": 1.25
    }
