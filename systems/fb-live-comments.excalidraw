    {
      "id": "eZl7yognpgrw-3KlAoXAm",
      "type": "text",
      "x": 868.5184107149241,
      "y": 4520.906196506871,
      "width": 801.8193359375,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
