    {
      "id": "YiDrL_Irj5MPFwq7kQP4e",
      "type": "text",
      "x": 5596.762136402436,
      "y": 2297.4364934546397,
      "width": 645.3394775390625,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
