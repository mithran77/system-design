      "versionNonce": 1946659632,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775235288369,
      "link": null,
      "locked": false,
      "text": "→ If short code is found and hasn't expired (by comparing the current date to the\nexpiration date in the database), the server retrieves the corresponding long URL.\n\n→ Not found URLs, return 404.\n\n→ Expired URLs, return 410 Gone status.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "bMJwbpHiSCxyII5SFy7pP",
      "originalText": "→ If short code is found and hasn't expired (by comparing the current date to the expiration date in the database), the server retrieves the corresponding long URL.\n\n→ Not found URLs, return 404.\n\n→ Expired URLs, return 410 Gone status.",
      "autoResize": true,
      "lineHeight": 1.25
    },
