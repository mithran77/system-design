    {
      "id": "eRP17vUBGK-w5x0lKVBpG",
      "type": "text",
      "x": 2339.6945205505176,
      "y": 2796.359897540423,
      "width": 806.1593627929688,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 789022683,
      "version": 484,
      "versionNonce": 195024336,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775232533731,
      "link": null,
      "locked": false,
      "text": "→ 2 types of HTTP redirects:\n\n→ 301 (Permanent Redirect),\n        → Resource permanently moved to target URL.\n        → Browsers cache this response, \n        → Subsequent requests go directly to long URL, bypassing our server.\n\nHTTP/1.1 301 Moved Permanently\nLocation: https://www.original-long-url.com\n\n→ 302 (Found),\n        → Resource temporarily located at different URL.\n        → Browsers do not cache this response\n        → Future requests always go through our server first.\n\nHTTP/1.1 302 Found\nLocation: https://www.original-long-url.com\n\n→ 302 redirect is often preferred because:\n        → More control over redirection, allowing to update or expire links when needed.\n        → Prevents browsers caching redirects, can cause sonsistency issues when we need\nto change or delete the short URL.\n        → Allows to track click statistics for each short URL (even though this is out of scope\nfor this design).\n\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "jiekSUidM_ncPmK4qEXYn",
      "originalText": "→ 2 types of HTTP redirects:\n\n→ 301 (Permanent Redirect),\n        → Resource permanently moved to target URL.\n        → Browsers cache this response, \n        → Subsequent requests go directly to long URL, bypassing our server.\n\nHTTP/1.1 301 Moved Permanently\nLocation: https://www.original-long-url.com\n\n→ 302 (Found),\n        → Resource temporarily located at different URL.\n        → Browsers do not cache this response\n        → Future requests always go through our server first.\n\nHTTP/1.1 302 Found\nLocation: https://www.original-long-url.com\n\n→ 302 redirect is often preferred because:\n        → More control over redirection, allowing to update or expire links when needed.\n        → Prevents browsers caching redirects, can cause sonsistency issues when we need to change or delete the short URL.\n        → Allows to track click statistics for each short URL (even though this is out of scope for this design).\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
