      "isDeleted": false,
      "boundElements": null,
      "updated": 1768239909236,
      "link": null,
      "locked": false,
      "text": "→ Follow table's Primary key is used to find all users a particular user\nfollows\n→ Follow table's GSI is used to find all followers of a particular user",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Z36CqDJ2uxjkTHC4TXDNy",
      "originalText": "→ Follow table's Primary key is used to find all users a particular user follows\n→ Follow table's GSI is used to find all followers of a particular user",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y3IyYkIO3YRdtySwaxj2P",
      "type": "rectangle",
      "x": 865.9672906763308,
      "y": 3906.7513610969877,
      "width": 825.5660271246614,
      "height": 2119.7869580873567,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
