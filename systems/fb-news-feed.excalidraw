      "versionNonce": 71043195,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768239905986,
      "link": null,
      "locked": false,
      "text": "→ There will be times, though not necessarily part of the finctional reqs, \nwhere we need to be able to quicklly access a post by its postID (Hence it is\nthe primary key)\n→ Posts GSI is used to get a chronologically sorted order of posts for a user\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "NRuzK5btd42fvIHvWVW0Z",
      "originalText": "→ There will be times, though not necessarily part of the finctional reqs, \nwhere we need to be able to quicklly access a post by its postID (Hence it is the primary key)\n→ Posts GSI is used to get a chronologically sorted order of posts for a user\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
