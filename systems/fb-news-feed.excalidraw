    },
    {
      "id": "Epdit-5mOKwVa7--bpFgn",
      "type": "text",
      "x": 2283.604122572918,
      "y": 4426.973910430593,
      "width": 343.7796630859375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1W",
      "roundness": null,
      "seed": 1138581339,
      "version": 102,
      "versionNonce": 350854235,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768229617918,
      "link": null,
      "locked": false,
      "text": "Scaling works when load is divisible,\nYou can scale horizontally only if work\ncan be evenly split.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r02-SAQQcEGznqU4swyEV",
      "originalText": "Scaling works when load is divisible, You can scale horizontally only if work can be evenly split.",
      "autoResize": true,
      "lineHeight": 1.25
    },
