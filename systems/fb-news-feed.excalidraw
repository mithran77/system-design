    {
      "id": "pIPigoQ79kMTSulNiV_td",
      "type": "text",
      "x": 2715.3825961149314,
      "y": 3907.01826351818,
      "width": 797.7952025196778,
      "height": 1850,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
