    {
      "id": "9RSXpO6QURspWxwhz4YKQ",
      "type": "rectangle",
      "x": 740.4762899012917,
      "y": 2425.9494056611225,
      "width": 825.5660271246614,
      "height": 1085.8178122340923,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
