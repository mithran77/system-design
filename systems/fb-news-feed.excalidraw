      "link": null,
      "locked": false,
      "text": "APIs:\nuid retrieved from session cookies\n\n\nPOST /v1/urls/\n{\n    originalUrl,\n    customAlias?,\n    expiryDate?\n}\n->\n{\n    shortUrl\n}\n\n\nGET /<shortCode>\n-> 302 redirect to originalUrl\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\nuid retrieved from session cookies\n\n\nPOST /v1/urls/\n{\n    originalUrl,\n    customAlias?,\n    expiryDate?\n}\n->\n{\n    shortUrl\n}\n\n\nGET /<shortCode>\n-> 302 redirect to originalUrl\n",
