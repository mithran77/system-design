    {
      "id": "SdqPQBXxxO8CwKYj6bsdc",
      "type": "text",
      "x": 4728.084211833549,
      "y": 1854.0568359889849,
      "width": 811.739013671875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b20",
      "roundness": null,
      "seed": 510331184,
      "version": 753,
      "versionNonce": 869829584,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775235351320,
      "link": null,
      "locked": false,
      "text": "→ To prevent custom aliases from colliding with future counter-generated codes, consider\nprefixing generated codes with a character that custom aliases can't use, or store them in\nseparate namespaces\n\n→ Prefix approach (like prefixing generated codes with ~ or $) is essentially a lightweight\nversion of namespacing — you're encoding the namespace into the value itself rather than\nthe storage structure",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Cru_YT4OsL_iLayzv00Iq",
      "originalText": "→ To prevent custom aliases from colliding with future counter-generated codes, consider prefixing generated codes with a character that custom aliases can't use, or store them in separate namespaces\n\n→ Prefix approach (like prefixing generated codes with ~ or $) is essentially a lightweight version of namespacing — you're encoding the namespace into the value itself rather than the storage structure",
      "autoResize": true,
      "lineHeight": 1.25
    },
