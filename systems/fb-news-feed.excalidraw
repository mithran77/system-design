    {
      "id": "r2kUxi9WVmqAyNvaixwmS",
      "type": "text",
      "x": -408.43841004127034,
      "y": 4080.1428131384837,
      "width": 780.5391845703125,
      "height": 2075,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
