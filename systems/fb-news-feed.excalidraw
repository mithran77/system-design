    {
      "id": "yYVYJUO0Y4eE0L49SNkA3",
      "type": "text",
      "x": 4470.821930461444,
      "y": 1385.944528309145,
      "width": 778.6593017578125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 763347760,
      "version": 641,
      "versionNonce": 964865488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775235319487,
      "link": null,
      "locked": false,
      "text": "→ Deduplication: check if this exact long URL was already shortened and return the\nexisting short code\n\n→ Most shorteners allow multiple short codes for same long URL. Different users may\nwant separate expiration dates, independent analytics, or different custom aliases.\n\n→ Deduplication trades off storage efficiency for these features ⚖️",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "unKhLpa5-2DrKWeGyiuWI",
      "originalText": "→ Deduplication: check if this exact long URL was already shortened and return the existing short code\n\n→ Most shorteners allow multiple short codes for same long URL. Different users may want separate expiration dates, independent analytics, or different custom aliases.\n\n→ Deduplication trades off storage efficiency for these features ⚖️",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Cru_YT4OsL_iLayzv00Iq",
      "type": "rectangle",
