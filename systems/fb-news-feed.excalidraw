      "updated": 1768146337790,
      "link": null,
      "locked": false,
      "text": "APIs:\nuid retrieved from session cookies\n\n\nPOST /v1/posts/ -> postId\n{\n    title,\n    content,\n    media\n}\n\n\nPUT /v1/users/:friendId/followers\n\n\nGET /v1/feeds?cursor={timestamp}&size={page_size}\n->\n{\n    items: Post[],\n    nextCursor: string (createdAt)\n}",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\nuid retrieved from session cookies\n\n\nPOST /v1/posts/ -> postId\n{\n    title,\n    content,\n    media\n}\n\n\nPUT /v1/users/:friendId/followers\n\n\nGET /v1/feeds?cursor={timestamp}&size={page_size}\n->\n{\n    items: Post[],\n    nextCursor: string (createdAt)\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
