    {
      "id": "mvfLo7yiXY4DaiaFO-4rj",
      "type": "text",
      "x": 4641.163281468232,
      "y": 4481.264456112623,
      "width": 753.2593383789062,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 475071877,
      "version": 2086,
      "versionNonce": 316316490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775948867956,
      "link": null,
      "locked": false,
      "text": "SSE Reconnection Flow 🔄\n\n→ Every comment sent includes a unique event ID — comment ID works well for\nthis\n→ On disconnection, EventSource automatically reconnects (no client code needed)\n→ Browser sends Last-Event-ID header with the last successfully received event ID\n\n\nServer-Side on Reconnect:\n\n→ Server detects Last-Event-ID header on incoming connection\n→ Queries for all comments posted after that ID\n→ Replays missed comments before resuming normal live stream\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ipDvzWsjIUz83LAkCmqvT",
      "originalText": "SSE Reconnection Flow 🔄\n\n→ Every comment sent includes a unique event ID — comment ID works well for this\n→ On disconnection, EventSource automatically reconnects (no client code needed)\n→ Browser sends Last-Event-ID header with the last successfully received event ID\n\n\nServer-Side on Reconnect:\n\n→ Server detects Last-Event-ID header on incoming connection\n→ Queries for all comments posted after that ID\n→ Replays missed comments before resuming normal live stream\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
