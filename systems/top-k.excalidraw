    {
      "id": "mPg7IJt3pvVmHmCzRCWhO",
      "type": "rectangle",
      "x": 5992.738354011327,
      "y": 1712.044386919976,
      "width": 819.2148287573746,
      "height": 1268.6898155982317,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
