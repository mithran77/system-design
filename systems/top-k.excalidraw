      "versionNonce": 123218710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775934915864,
      "link": null,
      "locked": false,
      "text": "- Subscribe only to the topics with comments from \n    live videos that your clients are watching\n- Viewers of same video end up on same box based \n    on layer 7 LB. Leads to fewer topics to subscribe to\n    per server",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
