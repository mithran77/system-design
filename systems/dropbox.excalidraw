    {
      "id": "CYmh-hvDpw3tEXNPXDKro",
      "type": "text",
      "x": 2529.4917452553423,
      "y": 6897.24636435863,
      "width": 813.2932739257812,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2J",
