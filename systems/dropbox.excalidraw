    {
      "id": "Wof-yh1aLVJiMVA2yHNwq",
      "type": "text",
      "x": 865.4861124637956,
      "y": 1911.4133552183885,
      "width": 797.0535278320312,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2U",
