    },
    {
      "id": "JvaCnA3-NqFZT3S7wYGOM",
      "type": "text",
      "x": 3677.979123527045,
      "y": 4854.455414581727,
      "width": 789.6193237304688,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2N",
      "roundness": null,
      "seed": 1291148645,
      "version": 2296,
      "versionNonce": 962423211,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775272106494,
      "link": null,
      "locked": false,
      "text": "Instead of going to disk we access the mapping directly from memory. This difference in\naccess speed is significant:\n\n→ ⚡ Memory access time: ~100 nanoseconds (0.0001 ms)\n→ 💿 SSD access time: ~0.1 milliseconds\n→ 🐢 HDD access time: ~10 milliseconds\n\nThis means memory access is about 1,000x faster than SSD and 100,000x faster than\nHDD. In terms of operations per second:\n\n→ 🚀 Memory: Can support millions of reads per second\n→ ⚙️ SSD: ~100,000 IOPS (Input/Output Operations Per Second)\n→ 🐌 HDD: ~100-200 IOPS",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "lgZgjAN7D7_naa0Ua4GVV",
      "originalText": "Instead of going to disk we access the mapping directly from memory. This difference in access speed is significant:\n\n→ ⚡ Memory access time: ~100 nanoseconds (0.0001 ms)\n→ 💿 SSD access time: ~0.1 milliseconds\n→ 🐢 HDD access time: ~10 milliseconds\n\nThis means memory access is about 1,000x faster than SSD and 100,000x faster than HDD. In terms of operations per second:\n\n→ 🚀 Memory: Can support millions of reads per second\n→ ⚙️ SSD: ~100,000 IOPS (Input/Output Operations Per Second)\n→ 🐌 HDD: ~100-200 IOPS",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ipDvzWsjIUz83LAkCmqvT",
      "type": "rectangle",
      "x": 5576.464400680657,
      "y": 4305.789157645639,
      "width": 767.9622075975524,
      "height": 607.7148013231972,
      "angle": 0,
      "strokeColor": "#1e1e1e",
