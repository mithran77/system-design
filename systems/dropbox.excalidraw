    {
      "id": "R4nDOFOZykRsfvP00h0HT",
      "type": "rectangle",
      "x": 2069.24526948348,
      "y": 8656.286730953816,
      "width": 825.5660271246614,
      "height": 3092.987434568986,
      "angle": 0,
      "strokeColor": "#1e1e1e",
