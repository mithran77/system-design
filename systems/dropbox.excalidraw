      "link": null,
      "locked": false,
      "text": "APIs:\n\nuser info retrieved from session token or JWT\n\n\nPOST /files\n{\n  File, \n  FileMetadata\n}\n\n\nGET /files/{fileId}\n->\nFile & FileMetadata\n\n\nPOST /files/{fileId}/share\n{\n  User[] // The users to share the file with\n}\n\n\nGET /files/changes?since={timestamp}\n->\nChangeEvent{\n    fileId,\n    changeType (created | updated | deleted),\n    fileMetadata\n}[]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\n\nuser info retrieved from session token or JWT\n\n\nPOST /files\n{\n  File, \n  FileMetadata\n}\n\n\nGET /files/{fileId}\n->\nFile & FileMetadata\n\n\nPOST /files/{fileId}/share\n{\n  User[] // The users to share the file with\n}\n\n\nGET /files/changes?since={timestamp}\n->\nChangeEvent{\n    fileId,\n    changeType (created | updated | deleted),\n    fileMetadata\n}[]",
      "autoResize": true,
      "lineHeight": 1.25
