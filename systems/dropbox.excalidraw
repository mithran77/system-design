    {
      "id": "SdqPQBXxxO8CwKYj6bsdc",
      "type": "text",
      "x": 7301.612060688123,
      "y": 2888.674773176717,
      "width": 809.9991455078125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
