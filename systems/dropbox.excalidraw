      "boundElements": [],
      "updated": 1775314846284,
      "link": null,
      "locked": false,
      "text": "→ ✅ If short code is found and hasn't expired (by comparing the current date to the\nexpiration date in the database), the server retrieves the corresponding long URL. 302\n\n→ 🔍❌ Not found URLs, return 404.\n\n→ 💀 Expired URLs, return 410 Gone status.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "bMJwbpHiSCxyII5SFy7pP",
      "originalText": "→ ✅ If short code is found and hasn't expired (by comparing the current date to the expiration date in the database), the server retrieves the corresponding long URL. 302\n\n→ 🔍❌ Not found URLs, return 404.\n\n→ 💀 Expired URLs, return 410 Gone status.",
      "autoResize": true,
      "lineHeight": 1.25
    },
