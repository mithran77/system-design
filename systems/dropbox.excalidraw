    {
      "id": "r2EqBX5mIvb50ymzZNgJr",
      "type": "text",
      "x": -128.99035991824474,
      "y": 4024.7231236570365,
      "width": 918.899169921875,
      "height": 1650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
