      "isDeleted": false,
      "boundElements": [],
      "updated": 1767990895065,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements:\n\n- C>>A for Booking tickets (No double booking)\n- A>>C for Viewing and Searching events\n- Low latency Search (<500ms)\n- Scale to handle high throughput for popular events (10M\nusers/event)\n- Handle read heavy workloads (100:1)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "mYjWl2Dm29i01qH7ZcAAK",
      "originalText": "Non Functional Requirements:\n\n- C>>A for Booking tickets (No double booking)\n- A>>C for Viewing and Searching events\n- Low latency Search (<500ms)\n- Scale to handle high throughput for popular events (10M users/event)\n- Handle read heavy workloads (100:1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
