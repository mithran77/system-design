    {
      "id": "hWGQb8IZGBRdMXl35NFxY",
      "type": "text",
      "x": 1735.8373494222046,
      "y": 1930.3158282624127,
      "width": 528.1194458007812,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
