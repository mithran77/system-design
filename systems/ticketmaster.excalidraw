    {
      "id": "JbQd-IenSwI89ZDRoOG0P",
      "type": "text",
      "x": 1760.1883727379522,
      "y": 3914.487352945048,
      "width": 797.7952025196778,
      "height": 1150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
