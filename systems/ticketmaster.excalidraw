      "updated": 1767990885104,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n\n- View events\n- Search for events\n- Book tickets to events",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Q2iGJFPYvGamiXiAIySnL",
      "originalText": "Functional Requirements:\n\n- View events\n- Search for events\n- Book tickets to events",
      "autoResize": true,
      "lineHeight": 1.25
    },
