      "seed": 467724078,
      "version": 482,
      "versionNonce": 1260280174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767897582145,
      "link": null,
      "locked": false,
      "text": "APIs:\n\nGET /events/:eventId \n->\nEvent {\n    \"Id\",\n    \"location\",\n    \"performer\",\n    \"seatMap\": {},\n    \"tickets\": string[]\n}\n\n\nGET /events/search?keyword={keyword}&start={start_date}&end={end_date}&page={page_number}&pageSize={page_size}\n->\nPartial<Event>[]\n\n\nPOST /bookings/:eventId -> bookingId\n{\n    \"ticketIds\": string[],\n    \"paymentDetails\": {}\n}",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\n\nGET /events/:eventId \n->\nEvent {\n    \"Id\",\n    \"location\",\n    \"performer\",\n    \"seatMap\": {},\n    \"tickets\": string[]\n}\n\n\nGET /events/search?keyword={keyword}&start={start_date}&end={end_date}&page={page_number}&pageSize={page_size}\n->\nPartial<Event>[]\n\n\nPOST /bookings/:eventId -> bookingId\n{\n    \"ticketIds\": string[],\n    \"paymentDetails\": {}\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
