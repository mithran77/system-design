    {
      "id": "NUkZ5zakHLW-Vzgbkz4g_",
      "type": "text",
      "x": -302.4403416355607,
      "y": 3829.832985100243,
      "width": 877.658935546875,
      "height": 4400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
