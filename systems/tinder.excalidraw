      "text": "APIs:\n\n\n- uid retrieved from JWT/Session cookies\n\n\nPUT /v1/profile/\n{\n    name,\n    age,\n    minAge\n    maxAge,\n    interestedIn: \"male\" | \"female\" | \"both\",\n    maxDistance\n    ...\n}\n\n\nGET /v1/feed?lat={}&long={}&distance={}&cursor={timestamp}&size={page_size}\n->\nUser[]\n\n\nPOST /v1/swipe/:userId\n{\n    decision: \"Yes\" | \"No\"\n}",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\n\n\n- uid retrieved from JWT/Session cookies\n\n\nPUT /v1/profile/\n{\n    name,\n    age,\n    minAge\n    maxAge,\n    interestedIn: \"male\" | \"female\" | \"both\",\n    maxDistance\n    ...\n}\n\n\nGET /v1/feed?lat={}&long={}&distance={}&cursor={timestamp}&size={page_size}\n->\nUser[]\n\n\nPOST /v1/swipe/:userId\n{\n    decision: \"Yes\" | \"No\"\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
