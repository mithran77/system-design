    {
      "id": "8hef3_EBfMLtKrVHaCbkm",
      "type": "rectangle",
      "x": 2823.8861000160964,
      "y": 4888.248662950237,
      "width": 761.8772710706738,
      "height": 1332.2704418844187,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
