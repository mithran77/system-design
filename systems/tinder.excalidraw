      "text": "Sharded cassandra here just means cassandra\nused correctly (using shards/partitions)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "x-BgvhRoPD4HEgQPTTqAg",
      "originalText": "Sharded cassandra here just means cassandra used correctly (using shards/partitions)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KctqE0VHd1bM1_wNIAxb1",
      "type": "rectangle",
      "x": 726.5924783351502,
      "y": 3781.515803662988,
      "width": 897.9294415624289,
      "height": 3668.5782674404695,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
